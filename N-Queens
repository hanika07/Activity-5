import java.util.*;
class Solution {
    List<List<String>> res = new ArrayList<>();
    public List<List<String>> solveNQueens(int n) { solve(0, n, new int[n]); return res; }
    void solve(int r, int n, int[] q) {
        if (r == n) {
            List<String> s = new ArrayList<>();
            for (int c : q) s.add(".".repeat(c) + "Q" + ".".repeat(n - c - 1));
            res.add(s); return; }
        for (int c = 0; c < n; c++) {
            boolean ok = true;
            for (int i = 0; i < r; i++) if (q[i] == c || Math.abs(q[i] - c) == r - i) ok = false;
            if (ok) { q[r] = c; solve(r + 1, n, q); }
        }
    }
}
